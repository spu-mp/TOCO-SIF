import os

import numpy as np
import pandas as pd
from geopy.distance import geodesic

input_folder = "input"
sif_folder = "troposif"
output_folder = "output"

os.makedirs(output_folder, exist_ok=True)

buffer_radius = 9.0

input_files = [
    filename
    for filename in os.listdir(input_folder)
    if filename.lower().endswith(".csv")
]

sif_files = [
    filename
    for filename in os.listdir(sif_folder)
    if filename.lower().endswith(".csv")
]

if len(input_files) != 1:
    raise ValueError(
        f"Expected one input CSV in {input_folder}, found {len(input_files)}"
    )

if len(sif_files) != 1:
    raise ValueError(
        f"Expected one TROPOSIF CSV in {sif_folder}, found {len(sif_files)}"
    )

input_file = os.path.join(input_folder, input_files[0])
sif_file = os.path.join(sif_folder, sif_files[0])

print("Input file:", input_files[0])
print("TROPOSIF file:", sif_files[0])

evi_ndvi_nir_df = pd.read_csv(input_file)
sif_df = pd.read_csv(sif_file)

sif_df = sif_df.dropna(subset=["latitude", "longitude"]).copy()

sif_df["SIF_743"] = pd.to_numeric(
    sif_df["SIF_743"], errors="coerce"
)

sif_coordinates = sif_df[["latitude", "longitude"]].to_numpy()
sif_values = sif_df["SIF_743"].to_numpy()


def calculate_buffer_sif(latitude, longitude):
    if pd.isna(latitude) or pd.isna(longitude):
        return pd.Series([np.nan, 0])

    total_sif = 0.0
    observation_count = 0

    for i, (sif_lat, sif_lon) in enumerate(sif_coordinates):
        distance = geodesic(
            (latitude, longitude),
            (sif_lat, sif_lon),
        ).kilometers

        if distance <= buffer_radius:
            if not np.isnan(sif_values[i]):
                total_sif += sif_values[i]
                observation_count += 1

    if observation_count == 0:
        total_sif = np.nan

    return pd.Series([total_sif, observation_count])


evi_ndvi_nir_df[
    ["TROPOSIF_sum_9km", "TROPOSIF_count_9km"]
] = evi_ndvi_nir_df.apply(
    lambda row: calculate_buffer_sif(row["lat"], row["lon"]),
    axis=1,
)

output_file = os.path.join(
    output_folder,
    os.path.splitext(input_files[0])[0] + "_TROPOSIF_9km.csv",
)

evi_ndvi_nir_df.to_csv(output_file, index=False)

print("Processing completed successfully!")
print("Output saved:", output_file)
