
import os
import pandas as pd
import numpy as np
from netCDF4 import Dataset

# --------------------------------------------------
# 1. Define input and output directories
# --------------------------------------------------

csv_dir = "path/to/input/csv_files"
nc_dir = "path/to/ERA5/netcdf_files"
output_dir = "path/to/output/csv_files"

os.makedirs(output_dir, exist_ok=True)

# ERA5 variables selected for extraction
variables_to_extract = ['variables','of','choice']

# --------------------------------------------------
# 2. Identify and match CSV and NetCDF files
# --------------------------------------------------

csv_files = sorted(
    [f for f in os.listdir(csv_dir) if f.startswith('year1') and f.endswith('.csv')]
)

nc_files = sorted(
    [f for f in os.listdir(nc_dir) if f.startswith('year1') and f.endswith('.nc')]
)

# Create a dictionary for matching files by filename
nc_file_dict = {
    os.path.splitext(f)[0]: f for f in nc_files
}

# --------------------------------------------------
# 3. Process matching files
# --------------------------------------------------

for csv_file in csv_files:

    file_name = os.path.splitext(csv_file)[0]

    if file_name not in nc_file_dict:
        print(f"No matching NetCDF file found for {csv_file}")
        continue

    csv_path = os.path.join(csv_dir, csv_file)
    nc_path = os.path.join(nc_dir, nc_file_dict[file_name])

    # Read sampling-point data
    point_data = pd.read_csv(csv_path)

    # Open ERA5 NetCDF dataset
    with Dataset(nc_path, mode='r') as nc:

        lon_values = np.asarray(nc.variables['longitude'][:])
        lat_values = np.asarray(nc.variables['latitude'][:])

        # Extract the first time step
        data = {
            var: np.ma.asarray(nc.variables[var][0, :, :])
            for var in variables_to_extract
        }

    # --------------------------------------------------
    # 4. Extract nearest ERA5 grid-cell values
    # --------------------------------------------------

    def extract_nearest_value(row, variable):

        lat = row['OD-latitude']
        lon = row['OD-longitude']

        lon_idx = np.abs(lon_values - lon).argmin()
        lat_idx = np.abs(lat_values - lat).argmin()

        value = data[variable][lat_idx, lon_idx]

        return float(value) if not np.ma.is_masked(value) else np.nan

    # Append extracted environmental variables
    for variable in variables_to_extract:

        point_data[variable] = point_data.apply(
            extract_nearest_value,
            variable=variable,
            axis=1
        )

    # --------------------------------------------------
    # 5. Save processed dataset
    # --------------------------------------------------

    output_path = os.path.join(output_dir, csv_file)

    point_data.to_csv(output_path, index=False)

    print(f"Processed and saved: {csv_file}")
